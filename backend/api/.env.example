# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/constituency_ai

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=submissions
EMBEDDING_DIM=768

# Supabase (auth + storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=complaints-media

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# File Uploads
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_UPLOADS=3

# AI Services (urls when running as microservices)
AI_SERVICE_MODE=local
AI_SERVICES_BASE_URL=http://ai-services:8000
TRANSLATION_SERVICE_URL=http://translation:8002
SPEECH_SERVICE_URL=http://speech:8001
LLM_SERVICE_URL=http://llm:8003
VISION_SERVICE_URL=http://vision:8004
EMBEDDINGS_SERVICE_URL=http://embeddings:8005
OCR_SERVICE_URL=http://ocr:8006
RECOMMENDATION_SERVICE_URL=http://recommendation:8007

# Monitoring
SENTRY_DSN=